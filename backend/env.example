# Database
DATABASE_URL=postgresql://user:password@localhost:5432/igca_db

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760

# HelloAsso API (optionnel - pour synchronisation directe)
HELLOASSO_CLIENT_ID=your-helloasso-client-id
HELLOASSO_CLIENT_SECRET=your-helloasso-client-secret
HELLOASSO_CAMPAIGN_ID=your-campaign-id

